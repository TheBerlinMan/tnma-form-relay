{% comment %}
  Waitlist Relay snippet — email-capture form wired to the form-relay service.

  Usage in a theme section/template:
    {% render 'waitlist-relay', form_id: 'robertas-waitlist', endpoint: 'https://forms.youragency.com', turnstile_site_key: '0x4AAA...', show_name: true %}

  Notes:
  - The hidden "_honey" field is the honeypot. Keep it hidden via the inline
    style AND off-screen positioning; do not rename it (must match the server).
  - Pass show_name: true to also collect an optional first name (used in the
    thanks email greeting and the Resend Audience).
  - Pass turnstile_site_key to render the Turnstile widget. Strongly
    recommended on waitlist forms — they send mail to visitor-supplied
    addresses. The server only enforces tokens when TURNSTILE_SECRET_KEY is
    set in the deployment, so enable both together.
{% endcomment %}

{% assign fr_endpoint = endpoint | default: 'https://forms.youragency.com' %}

<form
  class="waitlist-relay"
  method="POST"
  action="{{ fr_endpoint }}/f/{{ form_id }}"
  accept-charset="UTF-8"
>
  <div class="waitlist-relay__field">
    <label for="wr-email">Email</label>
    <input id="wr-email" type="email" name="email" required autocomplete="email">
  </div>

  {% if show_name %}
  <div class="waitlist-relay__field">
    <label for="wr-name">Name (optional)</label>
    <input id="wr-name" type="text" name="name" maxlength="200" autocomplete="given-name">
  </div>
  {% endif %}

  {% comment %} Honeypot — invisible to humans, irresistible to bots {% endcomment %}
  <div style="position:absolute;left:-9999px;opacity:0;height:0;overflow:hidden" aria-hidden="true">
    <label for="wr-honey">Leave this field empty</label>
    <input id="wr-honey" type="text" name="_honey" tabindex="-1" autocomplete="off">
  </div>

  {% if turnstile_site_key != blank %}
  <div class="cf-turnstile" data-sitekey="{{ turnstile_site_key }}"></div>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  {% endif %}

  <button type="submit">Join the list</button>
</form>
